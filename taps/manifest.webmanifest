{
  "name": "ScholarTap Taps",
  "short_name": "Taps",
  "description": "Your QR, the people you've swapped cards with, and who tapped you.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0b0c",
  "theme_color": "#0d0b0c",
  "icons": [
    { "src": "../assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "../assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Show my QR", "short_name": "My QR", "url": "./?qr=1", "icons": [{ "src": "../assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a card", "short_name": "Scan", "url": "./?view=scan", "icons": [{ "src": "../assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Burn an NFC card", "short_name": "NFC", "url": "./?view=nfc", "icons": [{ "src": "../assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "My taps", "short_name": "Taps", "url": "./?view=taps", "icons": [{ "src": "../assets/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
